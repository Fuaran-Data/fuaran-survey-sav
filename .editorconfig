root = true

# Pin LF so Fantomas (and any editor) writes the same line endings the repo's
# .gitattributes (`* text=auto eol=lf`) checks out — without this, Fantomas 7
# falls back to Environment.NewLine and rewrites every formatted file with
# CRLF on Windows, leaving EOL-only churn in `git status` after each run.ps1.
[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Markdown hard line breaks are trailing double-spaces — don't strip them.
[*.md]
trim_trailing_whitespace = false

# F#: deliberately does NOT override any `fsharp_*` key, so Fantomas applies its
# own defaults uniformly. `max_line_length` is the one entry.
[*.{fs,fsx,fsi}]
max_line_length = 120
