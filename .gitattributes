# Pin canonical text-file line endings to LF.
#
# `text=auto` lets git detect text vs. binary; `eol=lf` pins the canonical in-repo
# line ending. On a Windows checkout, files stay LF on disk (no autocrlf round-trip
# churn), eliminating the recurring "LF will be replaced by CRLF the next time Git
# touches it" warnings and phantom "modified" churn on tool-regenerated files.

* text=auto eol=lf

# Explicit binary types — git's auto-detection is usually correct, but spell out
# the common ones to be safe.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.dll   binary
*.exe   binary
*.pdb   binary
*.nupkg binary
*.zip   binary
*.gz    binary

# Test fixtures are held byte-for-byte: SPSS files are binary, and the expected CSVs keep their
# CR LF line ends (RFC 4180) regardless of the checkout platform.
*.sav   binary
*.zsav  binary
tests/fixtures/expected*.csv -text
